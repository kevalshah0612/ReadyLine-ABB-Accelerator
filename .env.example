# Keep this file free of secrets. Copy it to .env and supply your own values.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
NVIDIA_ENABLE_THINKING=true
NVIDIA_MAX_TOKENS=16384
NVIDIA_TIMEOUT_SECONDS=180
READYLINE_DB=data/readyline.sqlite3
# Set to true behind HTTPS. Local HTTP requires false.
COOKIE_SECURE=false
